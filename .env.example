# ==============================================================================
# Multi-Agent Enterprise Code Reviewer & PR Quality Gate Environment Variables
# ==============================================================================

# LLM Provider Configuration (Optional - Local AST rules run without an API key)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT=30

# Qdrant Vector Database Configuration
# Options: "embedded" (runs in-memory without Docker), "server" (connects to Qdrant server)
QDRANT_MODE=embedded
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=codebase_context

# Embedding Provider Configuration
# Options: "local" (deterministic 384-dim hash projection, offline), "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=deterministic-384
EMBEDDING_DIM=384

# GitHub Pull Request Integration
GITHUB_WEBHOOK_SECRET=your-webhook-secret-token
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_DRY_RUN=true

# Quality Gate Default Policies
GATE_BLOCK_ON_CRITICAL=true
GATE_BLOCK_ON_HIGH=true
GATE_MAX_MEDIUM=5
GATE_MAX_LOW=15

# Frontend Configuration
VITE_API_URL=http://localhost:8000
